	<queryString language="SQL">
		<![CDATA[select ci.product_code, ci.product_name, ci.cost_per_item, ci.count, ci.total_discount, CAST(ci.total_cost  AS DECIMAL(12, 2)) AS total_cost, cart.created_by, cart.created_at, CAST(cart.total_invoice  AS DECIMAL(12, 2)) AS total_invoice 
